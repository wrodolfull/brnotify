    "bootstrap": "tsx src/bootstrap.ts",
    "test": "tsx --test src/time.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "luxon": "^3.7.1",
    "multer": "^2.5.0",
    "pg": "^8.16.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/luxon": "^3.6.2",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
